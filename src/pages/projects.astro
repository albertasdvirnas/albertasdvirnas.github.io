---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { projects } from '../data/projects';
---
<Base title="Projects" description="Open-source research software by Albertas Dvirnas for time series analysis, optical DNA mapping and single-molecule imaging.">
  <PageHead
    kicker="Research software"
    aside={`${projects.length} tools`}
    title="Projects"
    dek="Open-source computational tools for time series analysis, optical DNA mapping and single-molecule imaging."
  />
  <div class="cards" style="--min: 300px">
    {projects.map((p) => (
      <div>
        <div class="label" style="margin-bottom: 8px">{p.code}</div>
        <h2 class="h2" style="font-size: 28px; margin-bottom: 10px">{p.name}</h2>
        <p>{p.desc}</p>
        <div class="entry__links" style="margin: 0 0 6px">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
        <div>{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </div>
    ))}
  </div>
</Base>
