---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { outreach, games } from '../data/collabs';
import { monthLabel } from '../data/talks';
---
<Base title="Outreach" description="Popular-science writing and games by Albertas Dvirnas for a general audience.">
  <PageHead kicker="Outreach" title="Popular science" dek="Making research accessible — writing, games and other outreach for a broader audience." />

  <section class="sec" id="games">
    <div class="sec-head"><h2>Games</h2></div>
    <ol class="entry-list">
      {games.map((g) => (
        <li class="entry">
          <div class="entry__key">Game · {monthLabel(g.date)}</div>
          <div class="entry__body">
            <h3 class="entry__title"><a href={g.href}>{g.title}</a></h3>
            <p class="entry__sub">{g.desc}</p>
            <div>{g.tags.map((t) => <span class="tag">{t}</span>)}</div>
            <div class="entry__links"><a href={g.href}>Play in the browser →</a></div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec" id="writing">
    <div class="sec-head"><h2>Writing</h2></div>
    <ol class="entry-list">
      {outreach.map((o) => (
        <li class="entry">
          <div class="entry__key">{o.kind} · {monthLabel(o.date)}</div>
          <div class="entry__body">
            <h3 class="entry__title"><a href={o.href}>{o.title}</a></h3>
            <p class="entry__sub">{o.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
